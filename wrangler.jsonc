{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "animinati-collections",
  "main": "./dist/worker/index.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {}
}
